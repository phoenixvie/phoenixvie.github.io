{
  "name": "wu-lunch-android",
  "version": "0.2.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "test": "node --experimental-strip-types --test src/data.test.mjs scripts/preview-native.test.mjs scripts/pdf.test.mjs scripts/native-links.test.mjs scripts/i18n.test.mjs scripts/preferences.test.mjs",
    "check": "npm run test && tsc --noEmit && expo export --platform android",
    "bundle:preview": "node scripts/bundle-preview.mjs",
    "pretest": "npm run bundle:preview",
    "prestart": "npm run bundle:preview"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.3"
  }
}
